@model ToDoList

<h4 class="page-title">Görev Bilgilerini Düzenle</h4>
<div class="row">
	<div class="col-md-12">
		<div class="card">
			<div class="card-header">
				<div class="card-title">Görev Bilgileri</div>
			</div>
			<div class="card-body">
				<form asp-controller="ToDoList" asp-action="UpdateToDoList" method="post">
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>

					<div class="form-group">
						<label asp-for="ToDoListId">ID</label>
						<input asp-for="ToDoListId" class="form-control" readonly />
					</div>

					<div class="form-group">
						<label asp-for="Title">Görev</label>
						<input asp-for="Title" class="form-control" placeholder="Örn. Portfolyo sitesini tamamla" />
						<span asp-validation-for="Title" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="ImageUrl">Görsel URL</label>
						<input asp-for="ImageUrl" class="form-control" placeholder="Örn. https://..." />
						<span asp-validation-for="ImageUrl" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Date">Tarih</label>
						<input asp-for="Date" type="date" class="form-control" />
						<span asp-validation-for="Date" class="text-danger"></span>
					</div>

					<div class="d-flex justify-content-end">
						<a asp-controller="ToDoList" asp-action="Index" class="btn btn-secondary mr-2">Vazgeç</a>
						<button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>