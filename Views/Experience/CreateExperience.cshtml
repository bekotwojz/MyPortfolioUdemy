@model Experience

<h4 class="page-title">Yeni Deneyim Ekle</h4>
<div class="row">
	<div class="col-md-12">
		<div class="card">
			<div class="card-header">
				<div class="card-title">Deneyim Bilgileri</div>
			</div>
			<div class="card-body">
				<form asp-controller="Experience" asp-action="CreateExperience" method="post">
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>

					<div class="form-group">
						<label asp-for="ExperienceID">ID</label>
						<input asp-for="ExperienceID" class="form-control" placeholder="AUTO" disabled />
					</div>

					<div class="form-group">
						<label asp-for="Head">Başlık</label>
						<input asp-for="Head" class="form-control" placeholder="Örn. Şirket veya proje adı" />
						<span asp-validation-for="Head" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Title">Unvan</label>
						<input asp-for="Title" class="form-control" placeholder="Örn. Yazılım Geliştirici" />
						<span asp-validation-for="Title" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Date">Dönem</label>
						<input asp-for="Date" class="form-control" placeholder="Örn. 2022 - 2025" />
						<span asp-validation-for="Date" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Description">Açıklama</label>
						<textarea asp-for="Description" class="form-control" rows="5" placeholder="Deneyimle ilgili açıklama"></textarea>
						<span asp-validation-for="Description" class="text-danger"></span>
					</div>

					<div class="d-flex justify-content-end">
						<a asp-controller="Experience" asp-action="ExperienceList" class="btn btn-secondary mr-2">Vazgeç</a>
						<button type="submit" class="btn btn-primary">Ekle</button>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
